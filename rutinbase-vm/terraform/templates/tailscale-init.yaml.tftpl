#cloud-config
package_update: true
packages:
  - curl
  - ca-certificates

users:
  - default
  - name: ${username}
    sudo: ALL=(ALL) NOPASSWD:ALL
    shell: /bin/bash
    ssh_authorized_keys:
      - ${ssh_public_key}

runcmd:
  # Install Tailscale
  - curl -fsSL https://tailscale.com/install.sh | sh
  # Auto-connect Tailscale with auth key and hostname
  - tailscale up --authkey=${tailscale_auth_key} --hostname=${hostname}
